{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PatentViewer analysis result","type":"object","additionalProperties":false,
  "required":["similarity","concept_level","tech_summary","problem_summary","reasoning","tech_cluster","problem_cluster"],
  "properties":{
    "similarity":{"type":"integer","minimum":1,"maximum":5},
    "concept_level":{"description":"独立請求項の文言上の権利範囲の広さ。1は非常に狭く、5は非常に広い。","type":"integer","minimum":1,"maximum":5},
    "tech_summary":{"type":"string","minLength":1},"problem_summary":{"type":"string","minLength":1},"reasoning":{"type":"string","minLength":1},
    "tech_cluster":{"type":"string","minLength":1},"problem_cluster":{"type":"string","minLength":1},
    "model":{"type":"string"},"embedding_model":{"type":"string"},"prompt_version":{"type":"string"},"pdf_sha256":{"type":"string"},"run_id":{"type":"string"},
    "claim_traceability":{"type":"object"},
    "evidence_traceability":{"type":"object"}
  }
}
