{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local LLM claim breadth assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_level", "reason", "claim_number", "evidence_element_ids"],
  "properties": {
    "concept_level": {
      "description": "独立請求項の文言上の権利範囲の広さ。1は非常に狭く、5は非常に広い。",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "reason": {
      "description": "主な必須構成、権利範囲を狭める限定・広げる要因、および尺度に照らした評価理由。",
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "claim_number": {"type": "integer", "minimum": 1},
    "evidence_element_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 80},
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
