{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatentViewer 5x5 threat score",
  "type": "object",
  "additionalProperties": false,
  "required": ["similarity", "concept_level", "similarity_reason", "concept_level_reason"],
  "properties": {
    "similarity": {"type": "integer", "minimum": 1, "maximum": 5},
    "concept_level": {
      "description": "独立請求項の文言上の権利範囲の広さ。1は非常に狭く、5は非常に広い。",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "similarity_reason": {"type": "string", "minLength": 1, "maxLength": 800},
    "concept_level_reason": {
      "description": "主な必須構成、権利範囲を狭める限定・広げる要因、および尺度に照らした評価理由。",
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "claim_traceability": {"type": "object"},
    "evidence_traceability": {"type": "object"}
  }
}
